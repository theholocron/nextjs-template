{
  "name": "@theholocron/nextjs-template",
  "version": "1.7.9",
  "private": true,
  "description": "A modern NextJS template with pre-configured tools, best practices, and CI/CD setup for rapid application development.",
  "keywords": [
    "nextjs",
    "react",
    "template",
    "typescript"
  ],
  "homepage": "https://docs.theholocron.dev/nextjs-template/",
  "bugs": "https://github.com/theholocron/nextjs-template/issues",
  "repository": "theholocron/nextjs-template",
  "license": "MIT",
  "author": "Newton Koumantzelis",
  "type": "module",
  "scripts": {
    "audit": "knip",
    "build": "next build --webpack",
    "build:storybook": "storybook build",
    "dev": "next dev --webpack",
    "lint": "holocron run lint",
    "prepare": "husky",
    "prepreview": "next build --webpack",
    "preview": "npx serve@latest out",
    "release": "semantic-release",
    "start": "next start",
    "start:storybook": "storybook dev -p 6006",
    "test": "holocron run test",
    "test:coverage": "vitest run --project storybook --coverage",
    "test:cypress": "cypress open",
    "test:storybook": "vitest run --project storybook --coverage",
    "typecheck": "holocron run typecheck",
    "holocron": "holocron",
    "wiki": "holocron run wiki",
    "sync": "holocron run sync"
  },
  "dependencies": {
    "next": "^16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.42.7",
    "@chromatic-com/storybook": "^5.6.0",
    "@codecov/nextjs-webpack-plugin": "^2.0.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-coverage": "^3.0.2",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-links": "^10.6.5",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/builder-vite": "^10.6.5",
    "@storybook/nextjs-vite": "^10.6.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@theholocron/astro-config": "^8.8.2",
    "@theholocron/cli": "^4.19.0",
    "@theholocron/commitlint-config": "^8.8.2",
    "@theholocron/docs-theme": "^1.10.3",
    "@theholocron/eslint-config": "^8.8.2",
    "@theholocron/holocron-config": "^8.8.2",
    "@theholocron/holocron-plugin-github": "^4.19.0",
    "@theholocron/holocron-plugin-vercel": "^4.19.0",
    "@theholocron/lighthouse-config": "^8.8.2",
    "@theholocron/lint-staged-config": "^8.8.2",
    "@theholocron/prettier-config": "^8.8.2",
    "@theholocron/semantic-release-config": "^8.8.2",
    "@theholocron/skills": "^1.3.3",
    "@theholocron/storybook-config": "^8.8.2",
    "@theholocron/stylelint-config": "^8.8.2",
    "@theholocron/tsconfig": "^8.8.2",
    "@theholocron/vitest-config": "^8.8.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.28",
    "alex": "^11.0.1",
    "astro": "^7.4.2",
    "axe-playwright": "^2.2.2",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "cypress": "^16.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.6.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "sort-package-json": "^4.1.0",
    "storybook": "^10.6.5",
    "storybook-addon-pseudo-states": "^10.6.5",
    "stylelint": "^17.16.0",
    "tsc-files": "^1.1.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "cypress",
      "esbuild",
      "msw"
    ],
    "overrides": {
      "@commitlint/config-conventional>conventional-changelog-conventionalcommits": "7",
      "conventional-changelog-conventionalcommits": "10.4.1"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "releases": "https://github.com/theholocron/nextjs-template/releases",
  "wiki": "https://github.com/theholocron/nextjs-template/wiki"
}
