{
  "name": "@theholocron/nextjs-template",
  "version": "1.7.9",
  "private": true,
  "description": "A modern Next.js template with pre-configured tools, best practices, and CI/CD setup for rapid application development.",
  "keywords": [
    "nextjs",
    "template",
    "theholocron"
  ],
  "homepage": "https://docs.theholocron.dev/nextjs-template/",
  "bugs": "https://github.com/theholocron/nextjs-template/issues",
  "repository": "theholocron/nextjs-template",
  "license": "GPL-3.0",
  "author": "Newton Koumantzelis",
  "type": "module",
  "scripts": {
    "audit": "knip",
    "build": "next build --webpack",
    "build:storybook": "storybook build",
    "dev": "next dev --webpack",
    "lint": "docker run -e LOG_LEVEL=DEBUG -e RUN_LOCAL=true -v .:/tmp/lint --rm ghcr.io/super-linter/super-linter:latest",
    "prepare": "husky && playwright install chromium",
    "prepreview": "next build --webpack",
    "preview": "npx serve@latest out",
    "release": "semantic-release",
    "start": "next start",
    "start:storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:coverage": "vitest run --project storybook --coverage",
    "test:cypress": "cypress open",
    "test:storybook": "vitest run --project storybook --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.42.0",
    "@chromatic-com/storybook": "^5.3.1",
    "@codecov/nextjs-webpack-plugin": "^2.0.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-coverage": "^3.0.2",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/builder-vite": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@theholocron/astro-config": "^7.32.2",
    "@theholocron/cli": "^3.48.0",
    "@theholocron/commitlint-config": "^7.32.2",
    "@theholocron/docs-theme": "^1.9.3",
    "@theholocron/eslint-config": "^7.32.2",
    "@theholocron/holocron-config": "^7.32.2",
    "@theholocron/holocron-plugin-github": "^3.50.0",
    "@theholocron/holocron-plugin-vercel": "^3.50.0",
    "@theholocron/lighthouse-config": "^7.32.2",
    "@theholocron/lint-staged-config": "^7.32.2",
    "@theholocron/prettier-config": "^7.32.2",
    "@theholocron/semantic-release-config": "^7.32.2",
    "@theholocron/skills": "^1.3.2",
    "@theholocron/storybook-config": "^7.32.2",
    "@theholocron/stylelint-config": "^7.32.2",
    "@theholocron/tsconfig": "^7.32.2",
    "@theholocron/vitest-config": "^7.32.2",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.26",
    "alex": "^11.0.1",
    "astro": "^7.3.1",
    "axe-playwright": "^2.2.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "cypress": "^15.21.1",
    "eslint": "^10.10.0",
    "eslint-plugin-cypress": "^7.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "lint-staged": "^17.5.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "sort-package-json": "^4.0.0",
    "storybook": "^10.6.0",
    "storybook-addon-pseudo-states": "^10.6.0",
    "stylelint": "^17.15.0",
    "tsc-files": "^1.1.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "cypress",
      "esbuild",
      "msw"
    ],
    "overrides": {
      "@commitlint/config-conventional>conventional-changelog-conventionalcommits": "7",
      "conventional-changelog-conventionalcommits": "10.4.0"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "releases": "https://github.com/theholocron/nextjs-template/releases",
  "wiki": "https://github.com/theholocron/nextjs-template/wiki"
}
