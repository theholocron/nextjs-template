{
  "display": "Next.js Template",
  "extends": "@theholocron/tsconfig/nextjs",
  "compilerOptions": {
    "baseUrl": "./",
    "types": ["cypress", "@testing-library/jest-dom"],
    "paths": {
      "@/*": ["./*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["astro.config.ts", "cypress.config.ts", "cypress", "docs", "node_modules"]
}
